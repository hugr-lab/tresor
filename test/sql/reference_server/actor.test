# name: test/sql/reference_server/actor.test
# description: A node acting for an acl session end to end: Keycloak's token exchange, the reference server's grant (specs/008)
# group: [reference_server]

# set by scripts/ci/test_keycloak.sh: alice's token as a duckdb-acl node receives it (meant for acl-node only)
require-env TRESOR_KC_HOST

require-env TRESOR_KC_ISSUER

require-env TRESOR_KC_DOOR_TOKEN

require acl_stub

statement ok
LOAD '__BUILD_DIRECTORY__/extension/tresor/tresor.duckdb_extension';

# the owner: the etl service stores a secret and delegates it to the node, for the analysts
statement ok
CREATE SECRET etl (TYPE tresor, SCOPE 'tresor:{TRESOR_KC_HOST}', FLOW 'client_credentials', CLIENT_ID 'etl',
    CLIENT_SECRET 'etl-secret', ISSUER '{TRESOR_KC_ISSUER}');

statement ok
ATTACH 'tresor:{TRESOR_KC_HOST}' AS owner (INSECURE_HTTP true, SECRET etl);

statement ok
CREATE OR REPLACE PERSISTENT SECRET kc_actor_lake IN owner (TYPE http, SCOPE 'https://kc-actor.example',
    BEARER_TOKEN 'for-the-analysts', EXTRA_HTTP_HEADERS MAP {'X-Team': 'analysts'});

statement ok
CALL owner.add_delegation('kc_actor_lake', ['client:acl-node'], ['role:analysts']);

# the owner's attachment goes: under a session every service-login attachment serves its own secrets where no
# delegated one covers a path (specs/009), and two attachments covering one path are duckdb's tie to break
statement ok
DETACH owner;

# the node: its own login, acting for acl sessions
statement ok
CREATE SECRET node (TYPE tresor, SCOPE 'tresor:elsewhere', FLOW 'client_credentials', CLIENT_ID 'acl-node',
    CLIENT_SECRET 'node-secret', ISSUER '{TRESOR_KC_ISSUER}');

statement ok
ATTACH 'tresor:{TRESOR_KC_HOST}' AS node (INSECURE_HTTP true, SECRET node, ACT_FOR_SESSIONS true);

# as itself, the node holds nothing on the secret
query II
SELECT list_contains(roles, 'client:acl-node'), actor IS NULL FROM node.whoami();
----
true	true

query I
SELECT count(*) FROM which_secret('https://kc-actor.example/x', 'http') WHERE storage = 'node';
----
0

# alice's session opens: her token is exchanged at Keycloak, the exchanged one traded for a grant
query I
SELECT acl_stub_open('kc-1', '{TRESOR_KC_DOOR_TOKEN}', '{TRESOR_KC_ISSUER}', 300);
----
1

statement ok
SET acl_stub_session = 'kc-1';

query III
SELECT list_contains(roles, 'role:analysts'), list_contains(roles, 'client:acl-node'), actor FROM node.whoami();
----
true	false	client:acl-node

query II
SELECT name, storage FROM which_secret('https://kc-actor.example/x', 'http') WHERE storage = 'node';
----
kc_actor_lake	node

query I
SELECT tresor_secret_param('kc_actor_lake', 'extra_http_headers');
----
MAP(VARCHAR, VARCHAR) {X-Team=analysts}

# the session ends: the grant is revoked at the service
statement ok
SET acl_stub_session = '';

query I
SELECT acl_stub_close('kc-1', 'client');
----
1

statement ok
SET acl_stub_session = 'kc-1';

statement error
SELECT * FROM node.whoami();
----
no delegation grant here

statement ok
SET acl_stub_session = '';

statement ok
DETACH node;

statement ok
ATTACH 'tresor:{TRESOR_KC_HOST}' AS owner (INSECURE_HTTP true, SECRET etl);

statement ok
DROP PERSISTENT SECRET kc_actor_lake FROM owner;
