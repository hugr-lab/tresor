# name: test/sql/attach_options.test
# description: ATTACH options and the tresor secret type, refused before any network (specs/002)
# group: [sql]

statement ok
LOAD '__BUILD_DIRECTORY__/extension/tresor/tresor.duckdb_extension';

# plain http only to this machine
statement error
ATTACH 'tresor:secrets.example.invalid' AS corp (INSECURE_HTTP true);
----
INSECURE_HTTP is for a service on this machine only

statement error
ATTACH 'tresor:secrets.example.invalid' AS corp (LOGIN 'carrier-pigeon');
----
LOGIN is 'auto', 'browser' or 'device'

statement error
ATTACH 'tresor:secrets.example.invalid' AS corp (NO_SUCH_OPTION 1);
----
unknown ATTACH option

statement error
ATTACH 'tresor:secrets.example.invalid' AS corp (LOGIN_TIMEOUT 0);
----
LOGIN_TIMEOUT is a positive number of seconds

# the secret type: a flow and its own parameters, nothing else
statement error
CREATE SECRET s (TYPE tresor, CLIENT_ID 'x');
----
FLOW is required

statement error
CREATE SECRET s (TYPE tresor, FLOW 'password', CLIENT_ID 'x');
----
FLOW is 'client_credentials' or 'token'

statement error
CREATE SECRET s (TYPE tresor, FLOW 'client_credentials', CLIENT_ID 'x');
----
needs CLIENT_SECRET

statement error
CREATE SECRET s (TYPE tresor, FLOW 'token', TOKEN 't', CLIENT_SECRET 'x');
----
does not take CLIENT_SECRET

statement ok
CREATE SECRET s (TYPE tresor, SCOPE 'tresor:secrets.example.invalid', FLOW 'client_credentials',
                 CLIENT_ID 'etl', CLIENT_SECRET 'very-secret-value', OAUTH_SCOPE 'api://secrets/.default');

# the credential is redacted; what minted nothing is visible
query I
SELECT secret_string LIKE '%very-secret-value%' FROM duckdb_secrets() WHERE name = 's';
----
false

query I
SELECT secret_string LIKE '%client_id=etl%' FROM duckdb_secrets() WHERE name = 's';
----
true
