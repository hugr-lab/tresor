# name: test/sql/conformance/delegations.test
# description: duckdb-secrets/1 conformance - delegation rules, where the service offers delegation (specs/007)
# group: [conformance]

# TRESOR_CONFORMANCE_DELEGATION set: the service offers delegation, and the conformance client may create
# secrets and delegate its own (the reference server: etl)
require-env TRESOR_CONFORMANCE_DELEGATION

require-env TRESOR_CONFORMANCE_HOST

require-env TRESOR_CONFORMANCE_INSECURE

require-env TRESOR_CONFORMANCE_ISSUER

require-env TRESOR_CONFORMANCE_CLIENT_ID

require-env TRESOR_CONFORMANCE_CLIENT_SECRET

statement ok
LOAD '__BUILD_DIRECTORY__/extension/tresor/tresor.duckdb_extension';

statement ok
CREATE SECRET conformance_login (TYPE tresor, SCOPE 'tresor:{TRESOR_CONFORMANCE_HOST}',
    FLOW 'client_credentials', CLIENT_ID '{TRESOR_CONFORMANCE_CLIENT_ID}',
    CLIENT_SECRET '{TRESOR_CONFORMANCE_CLIENT_SECRET}', ISSUER '{TRESOR_CONFORMANCE_ISSUER}');

statement ok
ATTACH 'tresor:{TRESOR_CONFORMANCE_HOST}' AS svc (INSECURE_HTTP {TRESOR_CONFORMANCE_INSECURE});

statement ok
CREATE OR REPLACE PERSISTENT SECRET conformance_delegated IN svc (TYPE tresor, SCOPE 'tresor:delegated.invalid', FLOW 'token', TOKEN 'x');

query III
SELECT actors, subjects, mode FROM svc.add_delegation('conformance_delegated', ['client:conformance-node'], ['role:conformance_users']);
----
['client:conformance-node']	['role:conformance_users']	shared

query I
SELECT count(*) FROM svc.delegations('conformance_delegated');
----
1

# the rule's id is the service's: carried in a variable (a table function's arguments are constants)
statement ok
SET VARIABLE conformance_rule = (SELECT id FROM svc.delegations('conformance_delegated'));

query I
SELECT count(*) FROM svc.remove_delegation('conformance_delegated', getvariable('conformance_rule'));
----
1

query I
SELECT count(*) FROM svc.delegations('conformance_delegated');
----
0

statement ok
DROP PERSISTENT SECRET conformance_delegated FROM svc;
