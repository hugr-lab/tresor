# name: test/sql/conformance/secrets.test
# description: duckdb-secrets/1 conformance - a secret the service holds takes part in DuckDB's lookup (specs/004)
# group: [conformance]

# the service under test holds a secret the conformance client may use: TRESOR_CONFORMANCE_SECRET (its
# name), of type _SECRET_TYPE, whose scope covers _SECRET_PATH, with a parameter _SECRET_KEY =
# _SECRET_VALUE (scripts/ci/test_keycloak.sh seeds one in the reference server through the protocol)
require-env TRESOR_CONFORMANCE_HOST

require-env TRESOR_CONFORMANCE_INSECURE

require-env TRESOR_CONFORMANCE_ISSUER

require-env TRESOR_CONFORMANCE_CLIENT_ID

require-env TRESOR_CONFORMANCE_CLIENT_SECRET

require-env TRESOR_CONFORMANCE_SECRET

require-env TRESOR_CONFORMANCE_SECRET_TYPE

require-env TRESOR_CONFORMANCE_SECRET_PATH

require-env TRESOR_CONFORMANCE_SECRET_KEY

require-env TRESOR_CONFORMANCE_SECRET_VALUE

statement ok
LOAD '__BUILD_DIRECTORY__/extension/tresor/tresor.duckdb_extension';

statement ok
CREATE SECRET conformance_login (TYPE tresor, SCOPE 'tresor:{TRESOR_CONFORMANCE_HOST}',
    FLOW 'client_credentials', CLIENT_ID '{TRESOR_CONFORMANCE_CLIENT_ID}',
    CLIENT_SECRET '{TRESOR_CONFORMANCE_CLIENT_SECRET}', ISSUER '{TRESOR_CONFORMANCE_ISSUER}');

statement ok
ATTACH 'tresor:{TRESOR_CONFORMANCE_HOST}' AS svc (INSECURE_HTTP {TRESOR_CONFORMANCE_INSECURE});

# listed, with the use verb, without material
query III
SELECT type, list_contains(permissions, 'use'), version <> '' FROM svc.secrets() WHERE name = '{TRESOR_CONFORMANCE_SECRET}';
----
{TRESOR_CONFORMANCE_SECRET_TYPE}	true	true

# found by DuckDB's lookup, in the attached service's storage
query II
SELECT name, storage FROM which_secret('{TRESOR_CONFORMANCE_SECRET_PATH}', '{TRESOR_CONFORMANCE_SECRET_TYPE}');
----
{TRESOR_CONFORMANCE_SECRET}	svc

# the material arrives (tresor_secret_param needs allow_unredacted_secrets, the test runner's default)
query I
SELECT tresor_secret_param('{TRESOR_CONFORMANCE_SECRET}', '{TRESOR_CONFORMANCE_SECRET_KEY}');
----
VARCHAR {TRESOR_CONFORMANCE_SECRET_VALUE}

statement ok
DETACH svc;
