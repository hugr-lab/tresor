# name: test/sql/tresor.test
# description: The extension loads, and the tresor ATTACH type is registered (specs/001)
# group: [sql]

# a DONT_LINK loadable is invisible to `require` - loaded by build path, the runner's pattern
statement ok
LOAD '__BUILD_DIRECTORY__/extension/tresor/tresor.duckdb_extension';

query I
SELECT tresor_version() IS NOT NULL;
----
true

# the ATTACH type is ours: both spellings reach tresor's attach, whose discovery of a name that
# cannot resolve fails - the message proves the routing (specs/002). The path names the service
# WITHOUT a scheme (https is implied), like quack's `quack:host:port`.
statement error
ATTACH 'tresor:secrets.example.invalid' AS corp;
----
<REGEX>:.*tresor: discovery of secrets.example.invalid failed.*

statement error
ATTACH 'secrets.example.invalid:8443/v1' AS corp (TYPE tresor);
----
<REGEX>:.*tresor: discovery of secrets.example.invalid:8443/v1 failed.*

# why no scheme: before it looks at the type, duckdb's ATTACH treats an http(s):// path as a remote
# database FILE - it demands httpfs and forces READ_ONLY (DatabaseManager::AttachDatabase,
# FileSystem::IsRemoteFile). A scheme would drag both into every tresor attach. Where httpfs is loaded
# (this test shell links it since specs/006), the path reaches tresor, which refuses the scheme itself.
statement ok
SET autoload_known_extensions = false;

statement error
ATTACH 'tresor:https://secrets.example.invalid' AS corp;
----
<REGEX>:.*(requires extension 'httpfs'|name the service without a scheme).*
