# name: test/sql/attach/secrets.test
# description: The service's secrets in DuckDB's lookup; corp.secrets() (specs/004)
# group: [attach]

require-env TRESOR_TEST_PORT

statement ok
LOAD '__BUILD_DIRECTORY__/extension/tresor/tresor.duckdb_extension';

statement ok
CREATE SECRET etl_login (TYPE tresor, SCOPE 'tresor:127.0.0.1:{TRESOR_TEST_PORT}', FLOW 'client_credentials',
    CLIENT_ID 'etl', CLIENT_SECRET 's3cr3t', ISSUER 'http://127.0.0.1:{TRESOR_TEST_PORT}/idp');

statement ok
ATTACH 'tresor:127.0.0.1:{TRESOR_TEST_PORT}' AS corp (INSECURE_HTTP true);

# what the caller may see, and what it may do with each - no material
query IIIII
SELECT name, type, scope, permissions, dynamic FROM corp.secrets() ORDER BY name;
----
bad_value	mssql	['mssql://bad']	[use]	false
crm_ro	mssql	['mssql://crm.corp.example']	[use, annotate]	false
dyn	s3	['s3://dyn']	[use]	true
lake	s3	['s3://lake']	[use]	false
lake_team_a	s3	['s3://lake/team-a']	[use]	false
seen_not_used	s3	['s3://lake/restricted']	[annotate]	false

query III
SELECT owner, version, updated_at = TIMESTAMPTZ '2026-09-10 08:30:00+00' FROM corp.secrets() WHERE name = 'lake';
----
role:admins	7	true

# the lookup: duckdb's own rule, the longest scope wins, the storage is the catalog's name
query III
SELECT name, persistent, storage FROM which_secret('s3://lake/sales/2026.parquet', 's3');
----
lake	PERSISTENT	corp

query I
SELECT name FROM which_secret('s3://lake/team-a/x.parquet', 's3');
----
lake_team_a

# the type is part of the match, and a path no scope covers matches nothing
query I
SELECT count(*) FROM which_secret('s3://lake/x', 'gcs');
----
0

query I
SELECT count(*) FROM which_secret('s3://elsewhere/x', 's3');
----
0

# a secret the caller may see but not use never matches: the lookup falls back to the next scope
query I
SELECT name FROM which_secret('s3://lake/restricted/x', 's3');
----
lake

# material only on a match, then from the cache: the fake counts its fetches in the comment
query I
SELECT comment FROM corp.secrets() WHERE name = 'lake';
----
fetched 1

query I
SELECT name FROM which_secret('s3://lake/again', 's3');
----
lake

query I
SELECT comment FROM corp.secrets() WHERE name = 'lake';
----
fetched 1

# listing never fetches material
query I
SELECT comment FROM corp.secrets() WHERE name = 'crm_ro';
----
fetched 0

# duckdb_secrets(): the service's secrets, by descriptor only
query IIII
SELECT name, type, persistent, storage FROM duckdb_secrets() WHERE storage = 'corp' ORDER BY name LIMIT 2;
----
bad_value	mssql	true	corp
crm_ro	mssql	true	corp

query I
SELECT count(*) FROM duckdb_secrets(redact := false) WHERE storage = 'corp' AND secret_string LIKE '%crm_reader%';
----
0

# typed values arrive as DuckDB types (a name lookup: GetSecretByName); the function is refused where
# unredacted secrets may not be shown (the end of this file)

query IIIIIII
SELECT tresor_secret_param('crm_ro', 'host'), tresor_secret_param('crm_ro', 'port'),
       tresor_secret_param('crm_ro', 'encrypt'), tresor_secret_param('crm_ro', 'extra_http_headers'),
       tresor_secret_param('crm_ro', 'limits'), tresor_secret_param('crm_ro', 'replicas'),
       tresor_secret_param('crm_ro', 'password');
----
VARCHAR crm.corp.example	INTEGER 1433	BOOLEAN true	MAP(VARCHAR, VARCHAR) {X-Tenant=sales}	STRUCT(max_rows BIGINT, ratio DOUBLE) {'max_rows': 1000, 'ratio': 0.5}	VARCHAR[] [crm-a, crm-b]	VARCHAR p@ss-word

# a value that does not fit its type: the error names the secret and the key, never the value
statement error
SELECT tresor_secret_param('bad_value', 'port');
----
the parameter port of the secret bad_value is not a valid INTEGER

# seen, not usable
statement error
SELECT tresor_secret_param('seen_not_used', 'key_id');
----
you may see the secret seen_not_used of 127.0.0.1:{TRESOR_TEST_PORT}, but not use it

# a dynamic secret is refetched when it is about to expire (the fake's expire in 20 s, inside the margin)
query I
SELECT tresor_secret_param('dyn', 'key_id');
----
VARCHAR DYN-1

query I
SELECT tresor_secret_param('dyn', 'key_id');
----
VARCHAR DYN-2

# DETACH: the secrets leave the lookup; ATTACH again brings them back (the same storage, reactivated)
statement ok
DETACH corp;

query I
SELECT count(*) FROM which_secret('s3://lake/x', 's3');
----
0

query I
SELECT count(*) FROM duckdb_secrets() WHERE storage = 'corp';
----
0

statement ok
ATTACH 'tresor:127.0.0.1:{TRESOR_TEST_PORT}' AS corp (INSECURE_HTTP true);

query I
SELECT name FROM which_secret('s3://lake/x', 's3');
----
lake

statement ok
DETACH corp;

# writes are the next spec's
statement ok
ATTACH 'tresor:127.0.0.1:{TRESOR_TEST_PORT}' AS corp (INSECURE_HTTP true);

statement error
DROP PERSISTENT SECRET lake FROM corp;
----
not supported yet (specs/005)

# a service whose secrets list is down: the lookup fails closed, naming the service
statement ok
ATTACH 'tresor:127.0.0.1:{TRESOR_TEST_PORT}/broken' AS broken (INSECURE_HTTP true);

statement error
SELECT * FROM which_secret('s3://lake/x', 's3');
----
listing the secrets of 127.0.0.1:{TRESOR_TEST_PORT}/broken

# where unredacted secrets may not be shown, neither may tresor_secret_param (a one-way switch: last)
statement ok
SET allow_unredacted_secrets = false;

statement error
SELECT tresor_secret_param('lake', 'key_id');
----
allow_unredacted_secrets = false
