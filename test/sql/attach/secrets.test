# name: test/sql/attach/secrets.test
# description: The service's secrets in DuckDB's lookup; corp.secrets() (specs/004)
# group: [attach]

require-env TRESOR_TEST_PORT

statement ok
LOAD '__BUILD_DIRECTORY__/extension/tresor/tresor.duckdb_extension';

statement ok
CREATE SECRET etl_login (TYPE tresor, SCOPE 'tresor:127.0.0.1:{TRESOR_TEST_PORT}', FLOW 'client_credentials',
    CLIENT_ID 'etl', CLIENT_SECRET 's3cr3t', ISSUER 'http://127.0.0.1:{TRESOR_TEST_PORT}/idp');

statement ok
ATTACH 'tresor:127.0.0.1:{TRESOR_TEST_PORT}' AS corp (INSECURE_HTTP true);

# what the caller may see, and what it may do with each - no material (the fake's seeded secrets: other
# test files write their own)
query IIIII
SELECT name, type, scope, permissions, dynamic FROM corp.secrets() WHERE owner = 'role:admins' ORDER BY name;
----
bad_value	mssql	['mssql://bad']	[use]	false
bare_number	mssql	['mssql://bare']	[use]	false
crm_ro	mssql	['mssql://crm.corp.example']	[use, annotate]	false
dyn	s3	['s3://dyn']	[use]	true
dyn_expired	s3	['s3://dyn-expired']	[use]	true
lake	s3	['s3://lake']	[use]	false
lake_team_a	s3	['s3://lake/team-a']	[use]	false
planted	tresor	['tresor:127.0.0.1']	[use]	false
seen_not_used	s3	['s3://lake/restricted']	[annotate]	false

query III
SELECT owner, version, updated_at = TIMESTAMPTZ '2026-09-10 08:30:00+00' FROM corp.secrets() WHERE name = 'lake';
----
role:admins	7	true

# the lookup: duckdb's own rule, the longest scope wins, the storage is the catalog's name
query III
SELECT name, persistent, storage FROM which_secret('s3://lake/sales/2026.parquet', 's3');
----
lake	PERSISTENT	corp

query I
SELECT name FROM which_secret('s3://lake/team-a/x.parquet', 's3');
----
lake_team_a

# the type is part of the match, and a path no scope covers matches nothing
query I
SELECT count(*) FROM which_secret('s3://lake/x', 'gcs');
----
0

query I
SELECT count(*) FROM which_secret('s3://elsewhere/x', 's3');
----
0

# a secret the caller may see but not use never matches: the lookup falls back to the next scope
query I
SELECT name FROM which_secret('s3://lake/restricted/x', 's3');
----
lake

# material only on a match, then from the cache: the fake counts its fetches in the comment
query I
SELECT comment FROM corp.secrets() WHERE name = 'lake';
----
fetched 1

query I
SELECT name FROM which_secret('s3://lake/again', 's3');
----
lake

query I
SELECT comment FROM corp.secrets() WHERE name = 'lake';
----
fetched 1

# listing never fetches material
query I
SELECT comment FROM corp.secrets() WHERE name = 'crm_ro';
----
fetched 0

# duckdb_secrets(): the service's secrets, by descriptor only
query IIII
SELECT name, type, persistent, storage FROM duckdb_secrets() WHERE storage = 'corp' AND name IN ('crm_ro', 'lake') ORDER BY name;
----
crm_ro	mssql	true	corp
lake	s3	true	corp

# a service's secret of type tresor is shown (corp.secrets()) but never takes part in DuckDB's lookup:
# a service must not be able to plant the login of another ATTACH
query I
SELECT count(*) FROM duckdb_secrets() WHERE name = 'planted';
----
0

statement ok
ATTACH 'tresor:127.0.0.1:{TRESOR_TEST_PORT}/expiring' AS corp2 (INSECURE_HTTP true);

query I
SELECT login FROM corp2.whoami();
----
client_credentials

statement ok
DETACH corp2;

query I
SELECT count(*) FROM duckdb_secrets(redact := false) WHERE storage = 'corp' AND secret_string LIKE '%crm_reader%';
----
0

# typed values arrive as DuckDB types (a name lookup: GetSecretByName); the function is refused where
# unredacted secrets may not be shown (the end of this file)

query IIIIII
SELECT tresor_secret_param('crm_ro', 'host'), tresor_secret_param('crm_ro', 'port'),
       tresor_secret_param('crm_ro', 'encrypt'), tresor_secret_param('crm_ro', 'extra_http_headers'),
       tresor_secret_param('crm_ro', 'limits'), tresor_secret_param('crm_ro', 'replicas');
----
VARCHAR crm.corp.example	INTEGER 1433	BOOLEAN true	MAP(VARCHAR, VARCHAR) {X-Tenant=sales}	STRUCT(max_rows BIGINT, ratio DOUBLE) {'max_rows': 1000, 'ratio': 0.5}	VARCHAR[] [crm-a, crm-b]

# numbers arrive with every digit (cast from their JSON text, not through a double)
query II
SELECT tresor_secret_param('crm_ro', 'big'), tresor_secret_param('crm_ro', 'amount');
----
HUGEINT 123456789012345678901234567890	DECIMAL(38,2) 12345678901234567890.12

# a redacted key shows its type only: the diagnostic is no way around redaction
query I
SELECT tresor_secret_param('crm_ro', 'password');
----
VARCHAR <redacted>

# a value that does not fit its type: the error names the secret, the key and the type - and ends there,
# no cast message quoting the value
statement error
SELECT tresor_secret_param('bad_value', 'port');
----
the parameter port of the secret bad_value is not a valid INTEGER

statement error
SELECT tresor_secret_param('bad_value', 'port');
----
<!REGEX>:.*not-a-number.*

# a bare non-string parameter is an error, not a silent NULL
statement error
SELECT tresor_secret_param('bare_number', 'port');
----
the parameter port of the secret bare_number is neither a string nor {type, value}

# seen, not usable: not a secret this caller can have by name
statement error
SELECT tresor_secret_param('seen_not_used', 'key_id');
----
no secret named 'seen_not_used'

# a dynamic secret is served from the cache for at most half its remaining life (the fake's live 20 s)...
query I
SELECT tresor_secret_param('dyn', 'key_id');
----
VARCHAR DYN-1

query I
SELECT tresor_secret_param('dyn', 'key_id');
----
VARCHAR DYN-1

# ...and one already expired is never reused
query I
SELECT tresor_secret_param('dyn_expired', 'key_id');
----
VARCHAR DYN-1

query I
SELECT tresor_secret_param('dyn_expired', 'key_id');
----
VARCHAR DYN-2

# DETACH: the secrets leave the lookup; ATTACH again brings them back (the same storage, reactivated)
statement ok
DETACH corp;

query I
SELECT count(*) FROM which_secret('s3://lake/x', 's3');
----
0

query I
SELECT count(*) FROM duckdb_secrets() WHERE storage = 'corp';
----
0

statement ok
ATTACH 'tresor:127.0.0.1:{TRESOR_TEST_PORT}' AS corp (INSECURE_HTTP true);

query I
SELECT name FROM which_secret('s3://lake/x', 's3');
----
lake

statement ok
DETACH corp;

# an ATTACH that does not commit leaves nothing in the lookup
statement ok
BEGIN;

statement ok
ATTACH 'tresor:127.0.0.1:{TRESOR_TEST_PORT}' AS rolled (INSECURE_HTTP true);

statement ok
ROLLBACK;

query I
SELECT count(*) FROM which_secret('s3://lake/x', 's3');
----
0

# a name duckdb's secret manager already uses is refused before any login
statement error
ATTACH 'tresor:127.0.0.1:{TRESOR_TEST_PORT}' AS local_file (INSECURE_HTTP true, LOGIN 'browser');
----
cannot attach as "local_file"

statement error
ATTACH 'tresor:127.0.0.1:{TRESOR_TEST_PORT}' AS connection (INSECURE_HTTP true, LOGIN 'browser');
----
cannot attach as "connection"

# and the secret manager still works
statement ok
CREATE SECRET mine (TYPE tresor, SCOPE 'tresor:mine.invalid', FLOW 'token', TOKEN 't');

# a service that cannot list its secrets is not attached
statement error
ATTACH 'tresor:127.0.0.1:{TRESOR_TEST_PORT}/nolist' AS nolist (INSECURE_HTTP true);
----
listing the secrets of 127.0.0.1:{TRESOR_TEST_PORT}/nolist

# a service whose material is down: a lookup it would win fails closed, naming the service and the
# secret; everything else - other paths, duckdb_secrets(), local secrets - is undisturbed
statement ok
ATTACH 'tresor:127.0.0.1:{TRESOR_TEST_PORT}/broken' AS broken (INSECURE_HTTP true);

statement error
SELECT * FROM which_secret('s3://lake/x', 's3');
----
the secret lake of 127.0.0.1:{TRESOR_TEST_PORT}/broken: HTTP 503

query I
SELECT count(*) FROM which_secret('s3://elsewhere/x', 's3');
----
0

query I
SELECT count(*) > 0 FROM duckdb_secrets() WHERE storage = 'broken';
----
true

statement ok
DROP SECRET mine;

statement ok
DETACH broken;

# where unredacted secrets may not be shown, neither may tresor_secret_param (a one-way switch: last)
statement ok
SET allow_unredacted_secrets = false;

statement error
SELECT tresor_secret_param('lake', 'key_id');
----
allow_unredacted_secrets = false
