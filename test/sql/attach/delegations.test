# name: test/sql/attach/delegations.test
# description: Delegation rules through the catalog: delegations, add_delegation, remove_delegation (specs/007)
# group: [attach]

require-env TRESOR_TEST_PORT

statement ok
LOAD '__BUILD_DIRECTORY__/extension/tresor/tresor.duckdb_extension';

statement ok
CREATE SECRET etl_login (TYPE tresor, SCOPE 'tresor:127.0.0.1:{TRESOR_TEST_PORT}', FLOW 'client_credentials',
    CLIENT_ID 'etl', CLIENT_SECRET 's3cr3t', ISSUER 'http://127.0.0.1:{TRESOR_TEST_PORT}/idp');

statement ok
ATTACH 'tresor:127.0.0.1:{TRESOR_TEST_PORT}' AS corp (INSECURE_HTTP true);

query I
SELECT count(*) FROM corp.delegations('crm_ro');
----
0

# shared by default; operations, scope and a ttl (an INTERVAL or seconds) narrow it
query IIIIIII
SELECT * FROM corp.add_delegation('crm_ro', ['client:acl-node-prod'], ['role:analysts'],
    operations := ['read'], scope := ['mssql://crm.corp.example'], ttl := INTERVAL 1 HOUR);
----
d-1	['client:acl-node-prod']	['role:analysts']	shared	[read]	['mssql://crm.corp.example']	3600

query IIII
SELECT id, actors, subjects, ttl FROM corp.delegations('CRM_RO');
----
d-1	['client:acl-node-prod']	['role:analysts']	3600

# the service decides what it can do: this one cannot issue personal credentials
statement error
CALL corp.add_delegation('crm_ro', ['client:acl-node-prod'], ['role:analysts'], mode := 'user');
----
only shared rules here

statement error
CALL corp.add_delegation('crm_ro', [], ['role:analysts']);
----
needs its actors and its subjects

query I
SELECT id FROM corp.remove_delegation('crm_ro', 'd-1');
----
d-1

query I
SELECT count(*) FROM corp.delegations('crm_ro');
----
0

statement error
CALL corp.remove_delegation('crm_ro', 'd-1');
----
the secret crm_ro has no delegation rule d-1

statement error
CALL corp.delegations('no_such_secret');
----
no secret no_such_secret

# a service that does not offer delegation: refused before any request
statement ok
ATTACH 'tresor:127.0.0.1:{TRESOR_TEST_PORT}/expiring' AS nodeleg (INSECURE_HTTP true);

statement error
CALL nodeleg.delegations('crm_ro');
----
does not offer delegation
