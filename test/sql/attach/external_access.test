# name: test/sql/attach/external_access.test
# description: enable_external_access = false stops tresor's own requests, on either HTTP client (specs/036)
# group: [attach]

require-env TRESOR_TEST_PORT

statement ok
LOAD '__BUILD_DIRECTORY__/extension/tresor/tresor.duckdb_extension';

statement ok
SET tresor_keychain = 'memory';

statement ok
CREATE SECRET etl_login (TYPE tresor, SCOPE 'tresor:127.0.0.1:{TRESOR_TEST_PORT}',
                         FLOW 'client_credentials', CLIENT_ID 'etl', CLIENT_SECRET 's3cr3t',
                         ISSUER 'http://127.0.0.1:{TRESOR_TEST_PORT}/idp');

statement ok
ATTACH 'tresor:127.0.0.1:{TRESOR_TEST_PORT}' AS corp (INSECURE_HTTP true);

# a person's login, remembered: its logoff comes below, with external access off (detached now - every service of
# the fake serves the same secrets' names, which two catalogs would make ambiguous)
statement ok
ATTACH 'tresor:127.0.0.1:{TRESOR_TEST_PORT}/second' AS person (INSECURE_HTTP true, LOGIN 'browser');

statement ok
DETACH person;

# fetched while the service may be reached: held in memory, as any secret DuckDB holds
query I
SELECT tresor_secret_param('lake_team_a', 'key_id');
----
VARCHAR AKIA-TEAM-A

statement ok
SET enable_external_access = false;

# a secret not fetched yet: tresor asks the service no more
statement error
SELECT tresor_secret_param('alice_lake', 'key_id');
----
file system operations are disabled by configuration

# what was fetched before stays served from memory until it expires
query I
SELECT tresor_secret_param('lake_team_a', 'key_id');
----
VARCHAR AKIA-TEAM-A

# a logoff still forgets the login: only its revocation at the IdP is refused
query III
SELECT removed, revoked, detached FROM tresor_logoff(service := '127.0.0.1:{TRESOR_TEST_PORT}/second',
    issuer := 'http://127.0.0.1:{TRESOR_TEST_PORT}/idp', client_id := 'duckdb');
----
true	false	0

statement ok
DETACH corp;

# no new attachment: its discovery is refused before anything is sent
statement error
ATTACH 'tresor:127.0.0.1:{TRESOR_TEST_PORT}' AS corp (INSECURE_HTTP true);
----
file system operations are disabled by configuration

# nor a person's login
statement error
FROM tresor_login('tresor:127.0.0.1:{TRESOR_TEST_PORT}', insecure_http := true);
----
file system operations are disabled by configuration
