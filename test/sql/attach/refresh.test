# name: test/sql/attach/refresh.test
# description: Dynamic secrets refreshed through the tresor provider behind httpfs's REFRESH auto (specs/006)
# group: [attach]

require-env TRESOR_TEST_PORT

require httpfs

statement ok
LOAD '__BUILD_DIRECTORY__/extension/tresor/tresor.duckdb_extension';

statement ok
CREATE SECRET etl_login (TYPE tresor, SCOPE 'tresor:127.0.0.1:{TRESOR_TEST_PORT}', FLOW 'client_credentials',
    CLIENT_ID 'etl', CLIENT_SECRET 's3cr3t', ISSUER 'http://127.0.0.1:{TRESOR_TEST_PORT}/idp');

statement ok
ATTACH 'tresor:127.0.0.1:{TRESOR_TEST_PORT}' AS corp (INSECURE_HTTP true);

# a dynamic s3 secret from the service: provider tresor, a refresh recipe of names only
query II
SELECT tresor_secret_param('dyn_s3', 'key_id'), tresor_secret_param('dyn_s3', 'refresh_info');
----
VARCHAR DYN-S3-1	STRUCT(tresor_service VARCHAR, tresor_secret VARCHAR) {'tresor_service': corp, 'tresor_secret': dyn_s3}

# a real read: the fake's S3 refuses the first key (403), httpfs refreshes the secret through the tresor
# provider, which fetches a fresh mint from the service, and the retried request succeeds
query I
SELECT rtrim(content, chr(10)) FROM read_text('s3://dynbucket/hello.txt');
----
hello from s3

# the lookup now serves a later mint (the requests of one read may fail in parallel; a mint younger than
# two seconds answers all of their refreshes) - and the refresh wrote nothing to the service
query I
SELECT tresor_secret_param('dyn_s3', 'key_id') NOT IN ('VARCHAR DYN-S3-1');
----
true

query I
SELECT comment FROM corp.secrets() WHERE name = 'dyn_s3';
----
writes 0

# a static service secret stored with httpfs's refresh recipe: the recipe is dropped, the provider kept -
# refreshing it through the reader's own provider would write the reader's credentials back
query II
SELECT tresor_secret_param('static_with_refresh', 'refresh_info'), tresor_secret_param('static_with_refresh', 'refresh');
----
NULL	NULL

# the provider creates only IN its service: service material never lands in memory or on disk
statement error
CREATE SECRET copy (TYPE s3, PROVIDER tresor, TRESOR_SERVICE 'corp', TRESOR_SECRET 'dyn_s3');
----
is created only IN corp

statement error
CREATE SECRET copy IN corp (TYPE s3, PROVIDER tresor, TRESOR_SERVICE 'elsewhere', TRESOR_SECRET 'dyn_s3');
----
is created only IN elsewhere

# ... what httpfs's refresh does, by hand: IN corp, a fresh mint, still no write
statement ok
CREATE OR REPLACE PERSISTENT SECRET dyn_s3 IN corp (TYPE s3, PROVIDER tresor, TRESOR_SERVICE 'corp', TRESOR_SECRET 'dyn_s3');

query I
SELECT comment FROM corp.secrets() WHERE name = 'dyn_s3';
----
writes 0

# an s3 secret written with REFRESH auto reaches the service without the recipe
statement ok
CREATE PERSISTENT SECRET written_refresh IN corp (TYPE s3, KEY_ID 'W', SECRET 'w', REFRESH auto, SCOPE 's3://written-refresh');

query II
SELECT tresor_secret_param('written_refresh', 'key_id'), tresor_secret_param('written_refresh', 'refresh_info');
----
VARCHAR W	NULL

statement ok
DROP PERSISTENT SECRET written_refresh FROM corp;
