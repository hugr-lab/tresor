# name: test/sql/attach/typed_secrets.test
# description: a secret served as its type's own class, as the type's deserializer makes it (specs/032)
# group: [attach]

require-env TRESOR_TEST_PORT

require typed_secret_stub

statement ok
LOAD '__BUILD_DIRECTORY__/extension/tresor/tresor.duckdb_extension';

# what the extension does with a secret of its own: a reference cast to its class (bigquery: BigquerySecret)
statement ok
CREATE TEMPORARY SECRET local_stub (TYPE typed_stub, PROJECT 'local-project', TOKEN 'tok-local',
    SCOPE 'stub://local');

query I
SELECT typed_stub_project('local_stub');
----
local-project

statement ok
DROP SECRET local_stub;

statement ok
CREATE SECRET etl_login (TYPE tresor, SCOPE 'tresor:127.0.0.1:{TRESOR_TEST_PORT}', FLOW 'client_credentials',
    CLIENT_ID 'etl', CLIENT_SECRET 's3cr3t', ISSUER 'http://127.0.0.1:{TRESOR_TEST_PORT}/idp');

statement ok
ATTACH 'tresor:127.0.0.1:{TRESOR_TEST_PORT}' AS corp (INSECURE_HTTP true);

statement ok
CREATE PERSISTENT SECRET typed_one IN corp (TYPE typed_stub, PROJECT 'corp-project', TOKEN 'tok-typed',
    SCOPE 'stub://one');

# found by name, as bigquery's SECRET option finds it: of the type's class
query I
SELECT typed_stub_project('typed_one');
----
corp-project

# found by path, as bigquery's bq://<project> lookup finds it
query I
SELECT typed_stub_lookup('stub://one/dataset');
----
corp-project

# a secret the service seeded: of the type's class, its typed values intact through the type's deserializer
query I
SELECT typed_stub_project('typed_seed');
----
seed-project

query III
SELECT tresor_secret_param('typed_seed', 'big'), tresor_secret_param('typed_seed', 'limits'),
       tresor_secret_param('typed_seed', 'replicas');
----
HUGEINT 123456789012345678901234567890	STRUCT(max_rows BIGINT, ratio DOUBLE) {'max_rows': 1000, 'ratio': 0.5}	VARCHAR[] [a, b]

# the class's own redaction holds, for a key the service does not redact
query I
SELECT tresor_secret_param('typed_seed', 'project_key');
----
VARCHAR <redacted>

# served again from tresor's cache (one fetch, the fake counts them): still of the type's class
query I
SELECT typed_stub_lookup('stub://seed/dataset');
----
seed-project

query I
SELECT comment FROM corp.secrets() WHERE name = 'typed_seed';
----
fetched 1

# a type whose deserializer reads a layout of its own gets the key-value secret, as before
statement ok
CREATE PERSISTENT SECRET opaque_one IN corp (TYPE opaque_stub, PROJECT 'p', TOKEN 'tok-opaque', SCOPE 'stub://two');

query I
SELECT opaque_stub_class('opaque_one');
----
KeyValueSecret

statement ok
DROP SECRET typed_one;

statement ok
DROP SECRET opaque_one;
