{
  "realm": "tresor",
  "enabled": true,
  "accessTokenLifespan": 300,
  "oauth2DeviceCodeLifespan": 600,
  "oauth2DevicePollingInterval": 1,
  "roles": {
    "realm": [
      {
        "name": "analysts"
      },
      {
        "name": "secrets_admin"
      },
      {
        "name": "etl"
      }
    ]
  },
  "clients": [
    {
      "clientId": "duckdb",
      "name": "DuckDB (tresor) - people",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://127.0.0.1/*"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "oauth2.device.authorization.grant.enabled": "true"
      },
      "protocolMappers": [
        {
          "name": "audience duckdb-secrets",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "duckdb-secrets",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "etl",
      "name": "An ETL service",
      "publicClient": false,
      "secret": "etl-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocolMappers": [
        {
          "name": "audience duckdb-secrets",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "duckdb-secrets",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "client_id (as the service_account scope adds it)",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "config": {
            "user.session.note": "client_id",
            "claim.name": "client_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@tresor.test",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Analyst",
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "alice-pass",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-tresor",
        "analysts"
      ]
    },
    {
      "username": "bob",
      "enabled": true,
      "email": "bob@tresor.test",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Admin",
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "bob-pass",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-tresor",
        "secrets_admin"
      ]
    },
    {
      "username": "service-account-etl",
      "enabled": true,
      "serviceAccountClientId": "etl",
      "realmRoles": [
        "default-roles-tresor",
        "etl"
      ]
    }
  ]
}
