{
  "realm": "spiffe",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      {"name": "nodes"},
      {"name": "secrets_admin"}
    ]
  },
  "identityProviders": [
    {
      "alias": "spire",
      "displayName": "The spike's SPIRE trust domain (tresor specs/046): JWT-SVIDs as client assertions",
      "providerId": "spiffe",
      "enabled": true,
      "config": {
        "trustDomain": "spiffe://tresor.example",
        "bundleEndpoint": "http://spire-oidc:8008/keys"
      }
    }
  ],
  "clients": [
    {
      "clientId": "acl-node",
      "name": "A node whose JWT-SVID is its client assertion (Signed JWT - Federated, SPIFFE)",
      "publicClient": false,
      "clientAuthenticatorType": "federated-jwt",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "attributes": {
        "jwt.credential.issuer": "spire",
        "jwt.credential.sub": "spiffe://tresor.example/node/acl-node"
      },
      "protocolMappers": [
        {
          "name": "audience duckdb-secrets",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "duckdb-secrets",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "client_id (as the service_account scope adds it)",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "config": {
            "user.session.note": "client_id",
            "claim.name": "client_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "seeder",
      "name": "The spike's administrator: puts the demo secret into the service and grants role:nodes its use",
      "publicClient": false,
      "secret": "seeder-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocolMappers": [
        {
          "name": "audience duckdb-secrets",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "duckdb-secrets",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "client_id (as the service_account scope adds it)",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "config": {
            "user.session.note": "client_id",
            "claim.name": "client_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-acl-node",
      "enabled": true,
      "serviceAccountClientId": "acl-node",
      "realmRoles": ["default-roles-spiffe", "nodes"]
    },
    {
      "username": "service-account-seeder",
      "enabled": true,
      "serviceAccountClientId": "seeder",
      "realmRoles": ["default-roles-spiffe", "secrets_admin"]
    }
  ]
}
